--- !u!114 &67991107304017948
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9058907458269832273}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4c50f8ca772295b4d9a077871033a4fd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  blendshapesSet: FaceTracking
  perBehaviorSet: 0
  parameterBehaviors:
  - targetMode: 0
    outputParameterName: VAP/FT/EyeSquintLeftForward
    targetBlendSetName: 
    targetBlendshapeName: 
    weightBlendSetName: 
    inputTrackingKeys: 00000000
    inputTrackingKeyNames:
    - EyeLookOutRight
    inputInverted: 00
    combineMode: 4
    customExpression: EyeSquintLeft
  - targetMode: 0
    outputParameterName: VAP/FT/EyeSquintRightForward
    targetBlendSetName: 
    targetBlendshapeName: 
    weightBlendSetName: 
    inputTrackingKeys: 
    inputTrackingKeyNames: []
    inputInverted: 
    combineMode: 4
    customExpression: EyeSquintRight
  - targetMode: 0
    outputParameterName: VAP/FT/PupilDilationForward
    targetBlendSetName: 
    targetBlendshapeName: 
    weightBlendSetName: 
    inputTrackingKeys: 
    inputTrackingKeyNames: []
    inputInverted: 
    combineMode: 4
    customExpression: (EyeDilationLeft + EyeDilationRight - EyeConstrictLeft - EyeConstrictRight)
      / 4 + 0.5
  - targetMode: 0
    outputParameterName: VAP/FT/BrowExpressionLeftForward
    targetBlendSetName: 
    targetBlendshapeName: vrc.v_sil
    weightBlendSetName: 
    inputTrackingKeys: 1700000015000000
    inputTrackingKeyNames:
    - BrowInnerUpLeft
    - BrowLowererLeft
    inputInverted: 0001
    combineMode: 4
    customExpression: BrowInnerUpLeft - BrowLowererLeft
  - targetMode: 0
    outputParameterName: VAP/FT/BrowExpressionRightForward
    targetBlendSetName: 
    targetBlendshapeName: 
    weightBlendSetName: 
    inputTrackingKeys: 1600000014000000
    inputTrackingKeyNames:
    - BrowInnerUpRight
    - BrowLowererRight
    inputInverted: 0001
    combineMode: 4
    customExpression: BrowInnerUpRight - BrowLowererRight
  - targetMode: 0
    outputParameterName: VAP/FT/NoseSneer
    targetBlendSetName: 
    targetBlendshapeName: 
    weightBlendSetName: 
    inputTrackingKeys: 3f00000000000000
    inputTrackingKeyNames:
    - NoseSneerLeft
    - EyeLookOutRight
    inputInverted: 0000
    combineMode: 4
    customExpression: (NoseSneerLeft + NoseSneerRight) / 2
  - targetMode: 0
    outputParameterName: VAP/FT/SmileFrownLeft
    targetBlendSetName: 
    targetBlendshapeName: 
    weightBlendSetName: 
    inputTrackingKeys: 00000000
    inputTrackingKeyNames:
    - EyeLookOutRight
    inputInverted: 00
    combineMode: 4
    customExpression: max(MouthCornerPullLeft, MouthCornerSlantLeft * 0.3) - MouthFrownLeft
  - targetMode: 0
    outputParameterName: VAP/FT/SmileFrownRight
    targetBlendSetName: 
    targetBlendshapeName: 
    weightBlendSetName: 
    inputTrackingKeys: 
    inputTrackingKeyNames: []
    inputInverted: 
    combineMode: 4
    customExpression: max(MouthCornerPullRight, MouthCornerSlantRight * 0.3) - MouthFrownRight
  - targetMode: 0
    outputParameterName: VAP/FT/MouthRaiserLower
    targetBlendSetName: 
    targetBlendshapeName: 
    weightBlendSetName: 
    inputTrackingKeys: 
    inputTrackingKeyNames: []
    inputInverted: 
    combineMode: 4
    customExpression: MouthRaiserLower
  - targetMode: 0
    outputParameterName: VAP/FT/MouthX
    targetBlendSetName: 
    targetBlendshapeName: 
    weightBlendSetName: 
    inputTrackingKeys: 
    inputTrackingKeyNames: []
    inputInverted: 
    combineMode: 4
    customExpression: (MouthUpperRight + MouthLowerRight - MouthUpperLeft - MouthLowerLeft)
      / 2
  - targetMode: 0
    outputParameterName: VAP/FT/JawX
    targetBlendSetName: 
    targetBlendshapeName: 
    weightBlendSetName: 
    inputTrackingKeys: 
    inputTrackingKeyNames: []
    inputInverted: 
    combineMode: 4
    customExpression: JawRight - JawLeft
  - targetMode: 0
    outputParameterName: VAP/FT/JawOpen
    targetBlendSetName: 
    targetBlendshapeName: 
    weightBlendSetName: 
    inputTrackingKeys: 
    inputTrackingKeyNames: []
    inputInverted: 
    combineMode: 4
    customExpression: JawOpen
  - targetMode: 0
    outputParameterName: VAP/FT/TongueOut
    targetBlendSetName: 
    targetBlendshapeName: 
    weightBlendSetName: 
    inputTrackingKeys: 
    inputTrackingKeyNames: []
    inputInverted: 
    combineMode: 4
    customExpression: TongueOut
  - targetMode: 0
    outputParameterName: VAP/FT/TongueX
    targetBlendSetName: 
    targetBlendshapeName: 
    weightBlendSetName: 
    inputTrackingKeys: 
    inputTrackingKeyNames: []
    inputInverted: 
    combineMode: 4
    customExpression: clamp(TongueRight - TongueLeft, -(1 + TongueOut) / 2, (1 +
      TongueOut) / 2)
  - targetMode: 0
    outputParameterName: VAP/FT/TongueY
    targetBlendSetName: 
    targetBlendshapeName: 
    weightBlendSetName: 
    inputTrackingKeys: 
    inputTrackingKeyNames: []
    inputInverted: 
    combineMode: 4
    customExpression: clamp(TongueUp - TongueDown, min(1 - TongueOut * 2, 0), (1
      + TongueOut) / 2)
  - targetMode: 0
    outputParameterName: VAP/FT/TongueTwist
    targetBlendSetName: 
    targetBlendshapeName: 
    weightBlendSetName: 
    inputTrackingKeys: 
    inputTrackingKeyNames: []
    inputInverted: 
    combineMode: 4
    customExpression: TongueTwistRight - TongueTwistLeft
  trackingKeyBehaviors:
  - trackingKey: MouthUpperUp
    mode: 3
    blendshapesSet: FaceTracking
    behavior:
      targetMode: 0
      outputParameterName: 
      targetBlendSetName: 
      targetBlendshapeName: 
      weightBlendSetName: 
      inputTrackingKeys: 
      inputTrackingKeyNames: []
      inputInverted: 
      combineMode: 4
      customExpression: 1 - max(MouthRaiserUpper, max(CheekPuffLeft, CheekPuffRight)
        * 5 - 1)
  - trackingKey: MouthLowerDown
    mode: 3
    blendshapesSet: FaceTracking
    behavior:
      targetMode: 0
      outputParameterName: 
      targetBlendSetName: 
      targetBlendshapeName: 
      weightBlendSetName: 
      inputTrackingKeys: 
      inputTrackingKeyNames: []
      inputInverted: 
      combineMode: 4
      customExpression: 1 - max(MouthRaiserUpper, max(CheekPuffLeft, CheekPuffRight)
        * 5 - 1)
  - trackingKey: MouthRaiser
    mode: 3
    blendshapesSet: FaceTracking
    behavior:
      targetMode: 0
      outputParameterName: 
      targetBlendSetName: 
      targetBlendshapeName: 
      weightBlendSetName: 
      inputTrackingKeys: 
      inputTrackingKeyNames: []
      inputInverted: 
      combineMode: 4
      customExpression: 2 - JawOpen * 5
